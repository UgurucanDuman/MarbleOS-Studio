{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarbleOS Studio Kurulumu",
  "version": "1.0.0",
  "identifier": "com.marbleos.studio.installer",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MarbleOS Studio Kurulumu",
        "width": 690,
        "height": 476,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "decorations": false,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'",
      "capabilities": ["installer"]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
