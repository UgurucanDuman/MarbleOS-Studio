{
  "identifier": "installer",
  "description": "Local Windows setup wizard permissions for MarbleOS Studio Installer",
  "windows": ["main"],
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-installer-init",
    "allow-installer-pick-dir",
    "allow-installer-check-dir",
    "allow-installer-run-install",
    "allow-installer-run-uninstall",
    "allow-installer-launch-app"
  ]
}
