{
  "name": "marbleos-studio",
  "private": true,
  "version": "1.0.0",
  "description": "MarbleOS Studio — Okul fotoğrafçılığı, idareci öğrenci kütük dosyası, sınıf albümü ve 300 DPI baskı çalışma alanı (React + TypeScript + Vite + Tauri + SQLite)",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "verify": "npm run typecheck && npm test && npm audit && npm run build",
    "build": "tsc -b && vite build",
    "tauri": "tauri",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.16",
    "@tauri-apps/api": "2.12.4",
    "fflate": "0.8.3",
    "motion": "^12.4.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "fake-indexeddb": "6.2.7",
    "jsdom": "^30.1.3",
    "typescript": "~5.6.2",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  }
}
